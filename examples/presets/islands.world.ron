// The islands preset (docs/product/user-stories.md, N2): islands in a sea, with sand along their
// shores, grass inland and rock on the heights, and trees on the grass. Three parameters tune it:
// how much of the world is land, how rough the land is, and how dense the trees grow. Every value
// in their ranges gives a sound world (tests/presets.rs sweeps them).
(
    version: 1,
    params: {
        // From a sea with a few islets at 0 to land with a few lakes at 1.
        "land": (default: 0.45, range: (0.0, 1.0)),
        // From gentle to rugged.
        "roughness": (default: 0.4, range: (0.0, 1.0)),
        // From bare land at 0 to dense woods at 1.
        "trees": (default: 0.5, range: (0.0, 1.0)),
    },
    water: Some((level: 0.0)),
    noises: {
        // Warped, so the coasts wind and the islands take irregular shapes.
        "islands": (noise_type: SimplexSmooth, seed: 11, frequency: 0.015, fractal_octaves: 3,
            domain_warp_enabled: true, domain_warp_amplitude: 30.0, domain_warp_frequency: 0.01, domain_warp_fractal_octaves: 2),
        // Ridged and warped: the spines of rock that run along the islands' interiors.
        "spines": (noise_type: SimplexSmooth, seed: 14, frequency: 0.02, fractal_type: Ridged, fractal_octaves: 3,
            domain_warp_enabled: true, domain_warp_amplitude: 20.0, domain_warp_frequency: 0.015, domain_warp_fractal_octaves: 2),
        "detail": (noise_type: SimplexSmooth, seed: 12, frequency: 0.08, fractal_octaves: 3),
        "woods": (noise_type: Perlin, seed: 13, frequency: 0.05, fractal_octaves: 2),
    },
    stages: [
        // The coast lies where the island noise crosses the land amount; the land rises from it and
        // roughness adds detail, the sea floor falling away below it. Inland, away from the coast,
        // ridges raise spines as tall as the roughness lets them.
        (name: "height", kind: Field(Add(
            Mul(
                Add(
                    Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))),
                    Mul(FastNoise("detail"), Mul(Param("roughness"), Constant(0.35))),
                ),
                Constant(14.0),
            ),
            Mul(
                Mul(
                    Pow(Remap(FastNoise("spines"), (-1.0, 1.0), (0.0, 1.0)), 2.0),
                    Clamp(Mul(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Constant(3.0)), 0.0, 1.0),
                ),
                Add(Constant(2.0), Mul(Param("roughness"), Constant(6.0))),
            ),
        ))),
        (name: "surface", kind: Rules(rules: [
            (category: "sand", when: [Less(Input("height"), Constant(1.2))]),
            (category: "rock", when: [Greater(Input("height"), Constant(9.0))]),
        ], otherwise: "grass")),
        // Trees on the grass, where the woods noise lies under the tree density.
        (name: "trees", kind: Scatter(kind: "tree", height: "height", spacing: 3, apart: 2,
            when: [
                Greater(Is("surface", ["grass"]), Constant(0.5)),
                Less(Clamp(Remap(FastNoise("woods"), (-0.6, 0.6), (0.0, 1.0)), 0.0, 1.0), Param("trees")),
            ])),
        // 0 to 1: how far a column lies below the ground around it, for the ground shader's cavity
        // channel, which darkens the hollows.
        (name: "around", kind: Blur(input: "height", radius: 4)),
        (name: "hollow", kind: Field(Clamp(Mul(Sub(Input("around"), Input("height")), Constant(0.6)), 0.0, 1.0))),
        // 0 to 1: wet at the water's edge and drying over the first cell above it, for the ground
        // shader's wetness channel.
        (name: "wet", kind: Field(Clamp(Remap(Input("height"), (0.0, 1.0), (1.0, 0.0)), 0.0, 1.0))),
        // The far ground beyond the view (docs/reference/packs.md, "Far ground"): the islands'
        // height over a world map of 8 by 8 cells a column, coloured by the same categories as the
        // surface.
        (name: "far_height", scale: 8, kind: Field(Add(
            Mul(
                Add(
                    Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))),
                    Mul(FastNoise("detail"), Mul(Param("roughness"), Constant(0.35))),
                ),
                Constant(14.0),
            ),
            Mul(
                Mul(
                    Pow(Remap(FastNoise("spines"), (-1.0, 1.0), (0.0, 1.0)), 2.0),
                    Clamp(Mul(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Constant(3.0)), 0.0, 1.0),
                ),
                Add(Constant(2.0), Mul(Param("roughness"), Constant(6.0))),
            ),
        ))),
        (name: "far_surface", scale: 8, kind: Rules(rules: [
            (category: "sand", when: [Less(Input("far_height"), Constant(1.2))]),
            (category: "rock", when: [Greater(Input("far_height"), Constant(9.0))]),
        ], otherwise: "grass")),
    ],
)
