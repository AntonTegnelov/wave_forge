// The islands preset (docs/product/user-stories.md, N2): islands in a sea, with sand along their
// shores, grass inland and rock on the heights, and trees on the grass. Three parameters tune it:
// how much of the world is land, how rough the land is, and how dense the trees grow. Every value
// in their ranges gives a sound world (tests/presets.rs sweeps them).
(
    version: 1,
    params: {
        // From a sea with a few islets at 0 to land with a few lakes at 1.
        "land": (default: 0.45, range: (0.0, 1.0)),
        // From gentle to rugged.
        "roughness": (default: 0.4, range: (0.0, 1.0)),
        // From bare land at 0 to dense woods at 1.
        "trees": (default: 0.5, range: (0.0, 1.0)),
    },
    water: Some((level: 0.0)),
    noises: {
        // Warped, so the coasts wind and the islands take irregular shapes.
        "islands": (noise_type: SimplexSmooth, seed: 11, frequency: 0.015, fractal_octaves: 3,
            domain_warp_enabled: true, domain_warp_amplitude: 30.0, domain_warp_frequency: 0.01, domain_warp_fractal_octaves: 2),
        // Ridged and warped: the spines of rock that run along the islands' interiors.
        "spines": (noise_type: SimplexSmooth, seed: 14, frequency: 0.02, fractal_type: Ridged, fractal_octaves: 3,
            domain_warp_enabled: true, domain_warp_amplitude: 20.0, domain_warp_frequency: 0.015, domain_warp_fractal_octaves: 2),
        "detail": (noise_type: SimplexSmooth, seed: 12, frequency: 0.08, fractal_octaves: 3),
        "woods": (noise_type: Perlin, seed: 13, frequency: 0.05, fractal_octaves: 2),
    },
    stages: [
        // The coast lies where the island noise crosses the land amount (`coast` crosses 0 there),
        // roughness adding detail inland only. From it the land is shaped by a curve: a shelf off
        // the coast that falls only gently before the sea floor drops away, a narrow beach, coastal
        // plains that rise slowly, and beyond them hills, rough as the roughness lets them, where
        // ridges raise spines of rock.
        (name: "coast", kind: Field(Add(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Mul(Mul(FastNoise("detail"), Mul(Param("roughness"), Constant(0.35))), Clamp(Mul(Sub(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Constant(0.3)), Constant(1.5)), 0.0, 1.0))))),
        (name: "land", kind: Field(Add(
            Mul(Curve(Input("coast"), [(-1.0, -1.0), (-0.35, -0.6), (-0.12, -0.08), (0.0, 0.02), (0.04, 0.09), (0.35, 0.17), (0.6, 0.4), (1.0, 0.85)]), Constant(14.0)),
            Mul(
                Mul(Pow(Remap(FastNoise("spines"), (-1.0, 1.0), (0.0, 1.0)), 2.0), Clamp(Mul(Sub(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Constant(0.3)), Constant(1.5)), 0.0, 1.0)),
                Add(Constant(2.0), Mul(Param("roughness"), Constant(6.0))),
            ),
        ))),
        // Gullies cut down the hills' steeper slopes, leaving the plains and the beaches as they lie.
        (name: "eroded", kind: Erode(input: "land", spacing: 16.0, octaves: 4, depth: 1.0, slope: 0.4, smooth: 3)),
        // Debris shed by the spines' steep rock settles below them (docs/reference/packs.md,
        // "Talus"): the ground is the higher of the eroded and the weathered ground, and the debris
        // how far the weathered ground stands above the eroded ground.
        (name: "weathered", kind: Talus(height: "eroded", region: 4, slope: 0.8, passes: 30, fade: 8)),
        (name: "height", kind: Field(Max(Input("eroded"), Input("weathered")))),
        (name: "debris", kind: Field(Max(Sub(Input("weathered"), Input("eroded")), Constant(0.0)))),
        (name: "surface", kind: Rules(rules: [
            (category: "sand", when: [Less(Input("height"), Constant(1.2))]),
            (category: "rock", when: [Greater(Input("height"), Constant(9.0))]),
            // Scree where the spines' debris lies deep enough to show.
            (category: "scree", when: [Greater(Input("debris"), Constant(0.25))]),
        ], otherwise: "grass")),
        // Broadleaf trees of five variants on the grass, where the woods noise lies under the tree
        // density, and bushes among them.
        // 0 to 1: how far into the woods a column lies, rising from their edge, so the trees thin
        // out toward it.
        (name: "thicket", kind: Field(Clamp(Mul(
            Sub(Param("trees"), Clamp(Remap(FastNoise("woods"), (-0.6, 0.6), (0.0, 1.0)), 0.0, 1.0)),
            Constant(10.0),
        ), 0.0, 1.0))),
        (name: "trees", kind: Scatter(height: "height", spacing: 3, apart: 3,
            kinds: [(kind: "broadleaf", weight: 3.0, variants: 5), (kind: "bush", variants: 2)],
            density: Some("thicket"), scale: (0.6, 1.0), stretch: (0.9, 1.15),
            when: [
                Greater(Is("surface", ["grass"]), Constant(0.5)),
                Less(Clamp(Remap(FastNoise("woods"), (-0.6, 0.6), (0.0, 1.0)), 0.0, 1.0), Param("trees")),
            ])),
        // Rocks on the rocky heights.
        (name: "rocks", kind: Scatter(kind: "rock", variants: 3, height: "height", spacing: 5,
            chance: 0.7, scale: (0.4, 1.1), tilt: (0.0, 15.0), align: 0.6,
            when: [Greater(Is("surface", ["rock"]), Constant(0.5))])),
        // 0 to 1: how far a column lies below the ground around it, or how much of the sky the land
        // around hides from it (`far_occlusion`), for the ground shader's cavity channel, which
        // darkens the hollows and the valleys.
        (name: "around", kind: Blur(input: "height", radius: 4)),
        (name: "hollow", kind: Field(Max(Clamp(Mul(Sub(Input("around"), Input("height")), Constant(0.6)), 0.0, 1.0), Input("far_occlusion")))),
        // The water that drains over the islands, from droplets rolling down the far ground's shape
        // at 4 cells a column (docs/reference/packs.md, "Droplets").
        (name: "flow", scale: 4, kind: Droplets(height: "far_height", region: 16, gives: Flow)),
        // 0 to 1, for the ground shader's wetness channel: wet at the water's edge and drying over
        // the first cell above it, and along the lines the land drains by.
        (name: "wet", kind: Field(Max(
            Clamp(Remap(Input("height"), (0.0, 1.0), (1.0, 0.0)), 0.0, 1.0),
            Clamp(Remap(Input("flow"), (4.0, 16.0), (0.0, 1.0)), 0.0, 1.0),
        ))),
        // The sea's level over every column, so the chunks around the player draw the sea as water
        // tinted by its depth over the ground, fading in at the shore, with wet banks
        // (docs/reference/packs.md, "Water surfaces"); the sea's plane covers it beyond them.
        (name: "water", kind: Field(Constant(0.0))),
        // The far ground beyond the view (docs/reference/packs.md, "Far ground"): the islands'
        // coast and height over a world map of 8 by 8 cells a column, coloured by the same
        // categories as the surface.
        (name: "far_coast", scale: 8, kind: Field(Add(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Mul(Mul(FastNoise("detail"), Mul(Param("roughness"), Constant(0.35))), Clamp(Mul(Sub(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Constant(0.3)), Constant(1.5)), 0.0, 1.0))))),
        (name: "far_height", scale: 8, kind: Field(Add(
            Mul(Curve(Input("far_coast"), [(-1.0, -1.0), (-0.35, -0.6), (-0.12, -0.08), (0.0, 0.02), (0.04, 0.09), (0.35, 0.17), (0.6, 0.4), (1.0, 0.85)]), Constant(14.0)),
            Mul(
                Mul(Pow(Remap(FastNoise("spines"), (-1.0, 1.0), (0.0, 1.0)), 2.0), Clamp(Mul(Sub(Add(FastNoise("islands"), Sub(Mul(Param("land"), Constant(1.2)), Constant(0.6))), Constant(0.3)), Constant(1.5)), 0.0, 1.0)),
                Add(Constant(2.0), Mul(Param("roughness"), Constant(6.0))),
            ),
        ))),
        // How much of the sky the land within 8 coarse columns hides from each, at the far
        // ground's scale (docs/reference/packs.md, "Horizon"): the far ground's cavity, and the
        // near ground's in its valleys, so the two darken alike where they meet.
        (name: "far_occlusion", scale: 8, kind: Horizon(input: "far_height", reach: 8)),
        (name: "far_surface", scale: 8, kind: Rules(rules: [
            (category: "sand", when: [Less(Input("far_height"), Constant(1.2))]),
            (category: "rock", when: [Greater(Input("far_height"), Constant(9.0))]),
        ], otherwise: "grass")),
    ],
)
