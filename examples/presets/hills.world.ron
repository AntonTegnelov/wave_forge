// The hills and forests preset (docs/product/user-stories.md, N2): rolling hills of meadow under
// woods, rock on the highest crowns, grass over the meadows, trees, bushes and ferns through the
// woods and rocks on the crowns. Three parameters tune it: how tall the hills rise, how much of the
// land the woods cover, and how thick the meadows' grass grows. Every value in their ranges gives a
// sound world (tests/presets.rs sweeps them).
(
    version: 1,
    params: {
        // From gentle swells at 0 to steep hills at 1.
        "hills": (default: 0.5, range: (0.0, 1.0)),
        // From open meadow at 0 to woods everywhere at 1.
        "forest": (default: 0.45, range: (0.0, 1.0)),
        // From bare meadows at 0 to thick grass at 1.
        "meadows": (default: 0.6, range: (0.0, 1.0)),
    },
    noises: {
        // Ridged and broad: the long ridgelines the hills run along.
        "chains": (noise_type: SimplexSmooth, seed: 29, frequency: 0.004, fractal_type: Ridged, fractal_octaves: 3,
            domain_warp_enabled: true, domain_warp_amplitude: 60.0, domain_warp_frequency: 0.003, domain_warp_fractal_octaves: 2),
        // Warped, so the hills wind rather than lining up.
        "hills": (noise_type: SimplexSmooth, seed: 21, frequency: 0.012, fractal_octaves: 4,
            domain_warp_enabled: true, domain_warp_amplitude: 40.0, domain_warp_frequency: 0.008, domain_warp_fractal_octaves: 2),
        "detail": (noise_type: SimplexSmooth, seed: 22, frequency: 0.07, fractal_octaves: 2),
        "woods": (noise_type: Perlin, seed: 23, frequency: 0.035, fractal_octaves: 2),
    },
    stages: [
        // The relief, about 0 to 2.6: warped hills under long ridgelines that wind through them,
        // and a little detail.
        (name: "relief", kind: Field(Add(Add(Mul(Add(FastNoise("hills"), Constant(1.0)), Constant(0.45)), Mul(Pow(Remap(FastNoise("chains"), (-1.0, 1.0), (0.0, 1.0)), 1.5), Constant(1.5))), Mul(FastNoise("detail"), Constant(0.08))))),
        // The land rises from 2 cells above the ground's zero by as much as the hills amount: the
        // low half of the relief lifted onto floors that rise only gently, where water would
        // settle and the meadows spread, and the rest rising from them as before.
        (name: "rolling", kind: Field(Add(Constant(2.0), Mul(Curve(Input("relief"), [(0.0, 0.55), (0.8, 0.6), (0.95, 0.7), (1.1, 0.95), (1.35, 1.45), (2.6, 3.2)]), Add(Constant(3.0), Mul(Param("hills"), Constant(7.0))))))),
        // Outcrops: from 3 cells below the rock's line, the ground steps up in treads and risers 2
        // cells high, as bands of rock weather.
        (name: "shape", kind: Field(Add(Input("rolling"), Mul(
            Sub(Mul(Add(Floor(Mul(Input("rolling"), Constant(0.5))), Pow(Sub(Mul(Input("rolling"), Constant(0.5)), Floor(Mul(Input("rolling"), Constant(0.5)))), 3.0)), Constant(2.0)), Input("rolling")),
            Clamp(Mul(Sub(Input("rolling"), Add(Constant(5.3), Mul(Param("hills"), Constant(14.7)))), Constant(0.33)), 0.0, 1.0),
        )))),
        // Gullies cut down the steeper slopes, so the tallest hills come out dissected and the
        // gentle ones keep their shape.
        (name: "height", kind: Erode(input: "shape", spacing: 20.0, octaves: 5, depth: 1.5, slope: 0.3, smooth: 3)),
        // 0 to 1: where the woods lie under the forest amount.
        (name: "woods", kind: Field(Clamp(Remap(FastNoise("woods"), (-0.6, 0.6), (0.0, 1.0)), 0.0, 1.0))),
        (name: "surface", kind: Rules(rules: [
            // The crowns of the tallest hills, a share of the way up whatever their height.
            (category: "rock", when: [Greater(Input("height"), Add(Constant(8.3), Mul(Param("hills"), Constant(14.7))))]),
            (category: "forest_floor", when: [Less(Input("woods"), Param("forest"))]),
        ], otherwise: "meadow")),
        // Grass over the meadows, as thick as the meadows amount.
        (name: "cover", kind: Field(Mul(Is("surface", ["meadow"]), Param("meadows")))),
        // Trees through the woods, three pines to a broadleaf, each of five variants, of varied sizes
        // and some taller for their width than others, thinning toward the woods' edge.
        // 0 to 1: how far into the woods a column lies, rising from their edge, so the trees thin
        // out toward it.
        (name: "thicket", kind: Field(Clamp(Mul(Sub(Param("forest"), Input("woods")), Constant(10.0)), 0.0, 1.0))),
        (name: "trees", kind: Scatter(height: "height", spacing: 3, apart: 3,
            kinds: [(kind: "pine", weight: 3.0, variants: 5), (kind: "broadleaf", variants: 5)],
            density: Some("thicket"), scale: (0.6, 1.0), stretch: (0.9, 1.15),
            when: [Greater(Is("surface", ["forest_floor"]), Constant(0.5))])),
        // Bushes and ferns under the trees, clear of their trunks.
        (name: "undergrowth", kind: Scatter(height: "height", spacing: 2, chance: 0.6,
            kinds: [(kind: "bush", variants: 2), (kind: "fern", weight: 2.0, variants: 3)],
            scale: (0.6, 1.2), block: [("trees", 1.0)],
            when: [Greater(Is("surface", ["forest_floor"]), Constant(0.5))])),
        // Rocks on the bare crowns, half sunk and leant into the slope.
        (name: "rocks", kind: Scatter(kind: "rock", variants: 3, height: "height", spacing: 5,
            chance: 0.7, scale: (0.4, 1.1), tilt: (0.0, 15.0), align: 0.6,
            when: [Greater(Is("surface", ["rock"]), Constant(0.5))])),
        // 0 to 1: how far a column lies below the ground around it, or how much of the sky the land
        // around hides from it (`far_occlusion`), for the ground shader's cavity channel, which
        // darkens the hollows and the valleys.
        (name: "around", kind: Blur(input: "height", radius: 4)),
        (name: "hollow", kind: Field(Max(Clamp(Mul(Sub(Input("around"), Input("height")), Constant(0.6)), 0.0, 1.0), Input("far_occlusion")))),
        // The far ground beyond the view (docs/reference/packs.md, "Far ground"): the hills' floors
        // and rise without the outcrops' steps or the gullies, too fine for a world map of 8 by 8
        // cells a column, coloured by the same categories as the surface.
        (name: "far_relief", scale: 8, kind: Field(Add(Add(Mul(Add(FastNoise("hills"), Constant(1.0)), Constant(0.45)), Mul(Pow(Remap(FastNoise("chains"), (-1.0, 1.0), (0.0, 1.0)), 1.5), Constant(1.5))), Mul(FastNoise("detail"), Constant(0.08))))),
        (name: "far_height", scale: 8, kind: Field(Add(Constant(2.0), Mul(Curve(Input("far_relief"), [(0.0, 0.55), (0.8, 0.6), (0.95, 0.7), (1.1, 0.95), (1.35, 1.45), (2.6, 3.2)]), Add(Constant(3.0), Mul(Param("hills"), Constant(7.0))))))),
        // How much of the sky the land within 8 coarse columns hides from each, at the far
        // ground's scale (docs/reference/packs.md, "Horizon"): the far ground's cavity, and the
        // near ground's in its valleys, so the two darken alike where they meet.
        (name: "far_occlusion", scale: 8, kind: Horizon(input: "far_height", reach: 8)),
        (name: "far_surface", scale: 8, kind: Rules(rules: [
            (category: "rock", when: [Greater(Input("far_height"), Add(Constant(8.3), Mul(Param("hills"), Constant(14.7))))]),
            (category: "forest_floor", when: [Less(Clamp(Remap(FastNoise("woods"), (-0.6, 0.6), (0.0, 1.0)), 0.0, 1.0), Param("forest"))]),
        ], otherwise: "meadow")),
    ],
)
