[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libwave_forge_godot.so"
linux.release.x86_64 = "res://bin/libwave_forge_godot.so"
macos.debug = "res://bin/libwave_forge_godot.dylib"
macos.release = "res://bin/libwave_forge_godot.dylib"
windows.debug.x86_64 = "res://bin/wave_forge_godot.dll"
windows.release.x86_64 = "res://bin/wave_forge_godot.dll"
