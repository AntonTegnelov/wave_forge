// The jungle folk's towns in the maximal preset's continent (docs/product/user-stories.md, M1):
// peoples of the rainforest and cloud forest: stepped stone halls, raised walkways between them, leaf-thatched roofs.
// Their faces and structure are the city's (examples/city.ron), whose rules keep streets, buildings,
// roofs, walkways and stairs walkable; the modules of their own are their materials, roofs,
// walkways and street furniture, and their weights shape their towns.
(
    faces: {
        "air": Side(connector: "air"),
        "railing": Side(connector: "air"),
        "wall": Side(connector: "building"),
        "ground": Side(connector: "ground", walkable: true),
        "ground_path": Side(connector: "ground", walkable: true, enforce_walkable_neighbor: true),
        "blocked": Side(connector: "ground"),
        "road": Side(connector: "road", walkable: true),
        "door": Side(connector: "door", symmetry: Plain, enforce_walkable_neighbor: true),
        "balcony": Side(connector: "balcony", symmetry: Plain),
        "walkway": Side(connector: "walkway", walkable: true, enforce_walkable_neighbor: true),
        "wall_side": Side(connector: "wall_side", symmetry: Plain),
        "open": Top(connector: "open"),
        "solid": Top(connector: "solid"),
        "bedrock": Top(connector: "bedrock"),
        "pillar": Top(connector: "pillar"),
        "stair": Top(connector: "stair", rotation: Some(0)),
    },
    connect: [
        ("building", "air"),
        ("building", "ground"),
        ("door", "ground"),
        ("balcony", "air"),
        ("wall_side", "building"),
    ],
    modules: [
        (name: "air", sides: ["air", "air", "air", "air"], up: "open", down: "open", weight: 4.0),
        (name: "grass", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 1.0, tags: ["street_level"], surface: "grass"),
        (name: "plaza", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.4, tags: ["street_level"], surface: "stone"),
        (name: "plaza_fountain", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.05, tags: ["street_level"], surface: "stone", sounds: [(at: (0.5, 0.5, 0.3), key: "fountain")]),
        (name: "plaza_lamp", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.1, tags: ["street_level"], surface: "stone"),
        (name: "road_straight", sides: ["road", "road", "ground", "ground"], up: "open", down: "bedrock", weight: 2.0, tags: ["street_level", "road"], surface: "asphalt"),
        (name: "road_corner", sides: ["road", "ground", "road", "ground"], up: "open", down: "bedrock", weight: 0.5, tags: ["street_level", "road"], surface: "asphalt"),
        (name: "road_t", sides: ["road", "road", "road", "ground"], up: "open", down: "bedrock", weight: 0.4, tags: ["street_level", "road"], surface: "asphalt"),
        (name: "road_cross", sides: ["road", "road", "road", "road"], up: "open", down: "bedrock", weight: 0.3, tags: ["street_level", "road"], surface: "asphalt"),
        (name: "road_end", sides: ["road", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.025, tags: ["street_level", "road"], surface: "asphalt"),
        (name: "building_base", sides: ["wall", "wall", "wall", "wall"], up: "solid", down: "bedrock", weight: 1.0, tags: ["street_level", "building"], surface: "wood", indoor: true, solid: true),
        (name: "building_door", sides: ["door", "wall", "wall", "wall"], up: "solid", down: "bedrock", weight: 0.3, tags: ["street_level", "building"], surface: "wood", indoor: true, solid: true),
        (name: "building_arcade", sides: ["ground_path", "ground_path", "wall", "wall"], up: "solid", down: "bedrock", weight: 0.4, tags: ["street_level", "building"], surface: "wood", indoor: true),
        (name: "building_floor", sides: ["wall", "wall", "wall", "wall"], up: "solid", down: "solid", weight: 1.0, tags: ["building"], surface: "wood", indoor: true, solid: true),
        (name: "building_balcony", sides: ["balcony", "wall", "wall", "wall"], up: "solid", down: "solid", weight: 0.3, tags: ["building"], surface: "wood", indoor: true),
        (name: "building_passage", sides: ["walkway", "walkway", "wall", "wall"], up: "solid", down: "solid", weight: 0.3, tags: ["building"], surface: "wood", indoor: true),
        (name: "roof_pyramid", sides: ["air", "air", "air", "air"], up: "open", down: "solid", weight: 0.9, tags: ["roof"]),
        (name: "roof_tower", sides: ["air", "air", "air", "air"], up: "open", down: "solid", weight: 0.15, tags: ["roof"]),
        (name: "roof_flat", sides: ["walkway", "walkway", "walkway", "walkway"], up: "open", down: "solid", weight: 0.3, tags: ["roof"], surface: "tiles"),
        (name: "roof_flat_edge", sides: ["railing", "walkway", "walkway", "walkway"], up: "open", down: "solid", weight: 0.3, tags: ["roof"], surface: "tiles"),
        (name: "roof_flat_corner", sides: ["railing", "walkway", "railing", "walkway"], up: "open", down: "solid", weight: 0.3, tags: ["roof"], surface: "tiles"),
        (name: "roof_flat_strip", sides: ["walkway", "walkway", "railing", "railing"], up: "open", down: "solid", weight: 0.15, tags: ["roof"], surface: "tiles"),
        (name: "roof_flat_end", sides: ["walkway", "railing", "railing", "railing"], up: "open", down: "solid", weight: 0.15, tags: ["roof"], surface: "tiles"),
        (name: "walkway_straight", sides: ["walkway", "walkway", "air", "air"], up: "open", down: "open", weight: 0.3, tags: ["walkway"], surface: "wood"),
        (name: "walkway_corner", sides: ["walkway", "air", "walkway", "air"], up: "open", down: "open", weight: 0.1, tags: ["walkway"], surface: "wood"),
        (name: "walkway_on_pillar", sides: ["walkway", "walkway", "air", "air"], up: "open", down: "pillar", weight: 0.3, tags: ["walkway"], surface: "wood"),
        (name: "pillar_base", sides: ["ground", "ground", "ground", "ground"], up: "pillar", down: "bedrock", weight: 0.1, tags: ["street_level"], surface: "stone"),
        (name: "pillar", sides: ["air", "air", "air", "air"], up: "pillar", down: "pillar", weight: 1.0, tags: ["pillar"]),
        (name: "stair", sides: ["blocked", "ground_path", "blocked", "blocked"], up: "stair", down: "bedrock", weight: 1.5, tags: ["street_level", "stair"], surface: "stone"),
        (name: "stair_roof", sides: ["railing", "walkway", "railing", "railing"], up: "stair", down: "solid", weight: 0.75, tags: ["roof", "stair"], surface: "stone"),
        (name: "stair_wall_street", sides: ["blocked", "ground_path", "wall_side", "blocked"], up: "stair", down: "bedrock", weight: 0.75, tags: ["street_level", "stair"], surface: "stone"),
        (name: "stair_wall", sides: ["air", "walkway", "wall_side", "railing"], up: "stair", down: "open", weight: 0.75, tags: ["stair"], surface: "stone"),
        (name: "stair_head", sides: ["walkway", "air", "air", "air"], up: "open", down: "stair", weight: 2.5, tags: ["walkway"], surface: "wood"),
        (name: "fern_floor", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.5, tags: ["street_level"], surface: "grass"),
        (name: "root_tangle", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.5, tags: ["street_level"], surface: "grass"),
        (name: "torch_pillar", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.05, tags: ["street_level"], surface: "stone"),
        (name: "idol", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.05, tags: ["street_level"], surface: "stone"),
        (name: "stone_path_straight", sides: ["road", "road", "ground", "ground"], up: "open", down: "bedrock", weight: 1.0, tags: ["street_level", "road"], surface: "stone_path"),
        (name: "stone_path_corner", sides: ["road", "ground", "road", "ground"], up: "open", down: "bedrock", weight: 0.25, tags: ["street_level", "road"], surface: "stone_path"),
        (name: "stone_path_t", sides: ["road", "road", "road", "ground"], up: "open", down: "bedrock", weight: 0.2, tags: ["street_level", "road"], surface: "stone_path"),
        (name: "stone_path_cross", sides: ["road", "road", "road", "road"], up: "open", down: "bedrock", weight: 0.15, tags: ["street_level", "road"], surface: "stone_path"),
        (name: "stone_path_end", sides: ["road", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.013, tags: ["street_level", "road"], surface: "stone_path"),
        (name: "carved_stone_base", sides: ["wall", "wall", "wall", "wall"], up: "solid", down: "bedrock", weight: 0.5, tags: ["street_level", "building"], surface: "carved_stone", indoor: true, solid: true),
        (name: "carved_stone_door", sides: ["door", "wall", "wall", "wall"], up: "solid", down: "bedrock", weight: 0.15, tags: ["street_level", "building"], surface: "carved_stone", indoor: true, solid: true),
        (name: "carved_stone_arcade", sides: ["ground_path", "ground_path", "wall", "wall"], up: "solid", down: "bedrock", weight: 0.2, tags: ["street_level", "building"], surface: "carved_stone", indoor: true),
        (name: "carved_stone_floor", sides: ["wall", "wall", "wall", "wall"], up: "solid", down: "solid", weight: 0.5, tags: ["building"], surface: "carved_stone", indoor: true, solid: true),
        (name: "carved_stone_balcony", sides: ["balcony", "wall", "wall", "wall"], up: "solid", down: "solid", weight: 0.15, tags: ["building"], surface: "carved_stone", indoor: true),
        (name: "carved_stone_passage", sides: ["walkway", "walkway", "wall", "wall"], up: "solid", down: "solid", weight: 0.15, tags: ["building"], surface: "carved_stone", indoor: true),
        (name: "leaf_thatch", sides: ["air", "air", "air", "air"], up: "open", down: "solid", weight: 0.45, tags: ["roof"]),
        (name: "stepped_crown", sides: ["air", "air", "air", "air"], up: "open", down: "solid", weight: 0.075, tags: ["roof"]),
        (name: "vine_roof", sides: ["railing", "walkway", "walkway", "walkway"], up: "open", down: "solid", weight: 0.15, tags: ["roof"], surface: "tiles"),
        (name: "carved_crest", sides: ["air", "air", "air", "air"], up: "open", down: "solid", weight: 0.45, tags: ["roof"]),
        (name: "rope_bridge", sides: ["walkway", "walkway", "air", "air"], up: "open", down: "open", weight: 0.3, tags: ["walkway"], surface: "wood"),
        (name: "rope_bridge_corner", sides: ["walkway", "air", "walkway", "air"], up: "open", down: "open", weight: 0.1, tags: ["walkway"], surface: "wood"),
        (name: "rope_bridge_on_pillar", sides: ["walkway", "walkway", "air", "air"], up: "open", down: "pillar", weight: 0.3, tags: ["walkway"], surface: "wood"),
        (name: "carved_pillar", sides: ["air", "air", "air", "air"], up: "pillar", down: "pillar", weight: 0.5, tags: ["pillar"]),
        (name: "altar", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.06, tags: ["street_level"], surface: "stone"),
        (name: "water_basin", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.06, tags: ["street_level"], surface: "stone"),
        (name: "totem", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.06, tags: ["street_level"], surface: "stone"),
        (name: "drum_stand", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.06, tags: ["street_level"], surface: "stone"),
        (name: "fruit_stall", sides: ["ground", "ground", "ground", "ground"], up: "open", down: "bedrock", weight: 0.06, tags: ["street_level"], surface: "stone"),
    ],
)
