// The maximal preset (docs/product/user-stories.md, M1): a finite continent of 2 048 by 2 048
// cells, 4 by 4 km at cells of 2 m, run whole ahead of time, in chunks of 8 by 8 columns: a town's
// region, a chunk and its halo, has to fit a GPU's workgroup memory with a culture's 135 tiles.
// Regions and footprints are counted in those chunks. This part is its terrain: a continent
// of named noises that falls into the ocean before the bound, mountain ranges of ridged noise,
// a temperature from latitude and height and a moisture from noise, fifty biomes chosen by rules
// over those, each shaping the ground its own way, lakes in the hollows and rivers carved from the
// high ground to the sea. Under the ground lies rock as a density volume, with cheese caves,
// overhangs on cliffs and ore; a location table of 33 kinds, levelled into the ground and joined
// by roads; and the settlements of a history a game gives as a table, levelled into the ground,
// each with a town of its culture's WFC module set (examples/continent/cultures). Heights are in cells of height, the sea at 0.
(
    version: 1,
    bound: Some(Rect(min: (0.0, 0.0), max: (2047.0, 2047.0))),
    water: Some((level: 0.0, lakes: Some("lakes"))),
    // The history a game simulates over the continent's map before play: its settlements, where
    // each stands, how large it grew, when it was founded, its culture and what became of it.
    tables: [
        (name: "settlements", kind: Given(columns: [
            ("x", Number), ("y", Number), ("size", Number), ("population", Number), ("founded", Number),
            ("culture", Names(["coastfolk", "steppe_riders", "woodlanders", "sand_dwellers",
                "highlanders", "marsh_folk", "jungle_folk", "frostfolk"])),
            ("fate", Names(["thriving", "declining", "ruined", "abandoned"])),
        ])),
    ],
    // The 3D noises of the rock: cheese caves, and the blobs that overhang cliffs.
    noises: {
        "caves": (noise_type: SimplexSmooth, seed: 31, frequency: 0.035, fractal_octaves: 2),
        "overhangs": (noise_type: SimplexSmooth, seed: 32, frequency: 0.06, fractal_octaves: 2),
    },
    stages: [
        // The continent's broad shape: low-frequency noise, pulled under the sea from 780 cells
        // out from the centre to 990, so the coast never reaches the bound.
        (name: "landmass", scale: 4, kind: Field(Noise(frequency: 0.0016, octaves: 5, name: Some("landmass")))),
        (name: "falloff", scale: 4, kind: Field(Smoothstep(780.0, 990.0, Distance((1024.0, 1024.0))))),
        (name: "base", scale: 4, kind: Field(Sub(
            Mul(Input("landmass"), Constant(1.6)),
            Add(Constant(0.5), Mul(Input("falloff"), Constant(1.2))),
        ))),
        // Where mountain ranges run, and their ridges: one minus the fold of a noise, sharp on top.
        (name: "ranges", scale: 4, kind: Field(Smoothstep(0.6, 0.75, Noise(frequency: 0.0011, octaves: 2, name: Some("ranges"))))),
        (name: "ridges", kind: Field(Sub(Constant(1.0),
            Abs(Sub(Mul(Noise(frequency: 0.006, octaves: 4, name: Some("ridges")), Constant(2.0)), Constant(1.0)))))),
        (name: "hills", kind: Field(Noise(frequency: 0.02, octaves: 3, name: Some("hills")))),
        // Plateaus lifted a score of cells, with steep rims, which give the highlands off the ranges.
        (name: "plateaus", scale: 4, kind: Field(Mul(Smoothstep(0.56, 0.64, Noise(frequency: 0.0018, octaves: 3, name: Some("plateaus"))), Constant(22.0)))),
        // The height before biomes: the landmass scaled to cells, and on land the ranges' ridges,
        // the plateaus and hills.
        (name: "height", kind: Field(Add(
            Mul(Input("base"), Constant(40.0)),
            Mul(
                Clamp(Mul(Input("base"), Constant(8.0)), 0.0, 1.0),
                Add(
                    Add(Mul(Mul(Input("ranges"), Input("ridges")), Constant(95.0)), Input("plateaus")),
                    Mul(Sub(Input("hills"), Constant(0.5)), Constant(8.0)),
                ),
            ),
        ))),
        // Temperature: warm in the south, cold in the north, with a noise of a fifth either way,
        // and colder higher up.
        (name: "temperature", kind: Field(Sub(
            Add(
                Remap(Y, (250.0, 1800.0), (1.05, 0.0)),
                Mul(Sub(Noise(frequency: 0.002, octaves: 3, name: Some("heat")), Constant(0.5)), Constant(0.4)),
            ),
            Mul(Max(Input("height"), Constant(0.0)), Constant(0.003)),
        ))),
        (name: "moisture", scale: 4, kind: Field(Clamp(Remap(Noise(frequency: 0.0025, octaves: 4, name: Some("moisture")), (0.3, 0.7), (0.0, 1.0)), 0.0, 1.0))),
        // Fifty biomes: the oceans and coasts by height, the peaks by height and temperature, and
        // below them five bands of temperature by four of moisture, in the lowlands and the
        // highlands. First match wins.
        (name: "biome", kind: Rules(
            rules: [
                (category: "deep_ocean", when: [Less(Input("height"), Constant(-15.0))]),
                (category: "ocean", when: [Less(Input("height"), Constant(-4.0))]),
                (category: "shallows", when: [Less(Input("height"), Constant(0.0))]),
                (category: "shingle", when: [Less(Input("height"), Constant(1.5)), Less(Input("temperature"), Constant(0.35))]),
                (category: "beach", when: [Less(Input("height"), Constant(1.5))]),
                (category: "glacier", when: [Less(Input("temperature"), Constant(0.02))]),
                (category: "ice_peaks", when: [Greater(Input("height"), Constant(70.0)), Less(Input("temperature"), Constant(0.35))]),
                (category: "snow_peaks", when: [Greater(Input("height"), Constant(70.0))]),
                (category: "alpine_meadow", when: [Greater(Input("height"), Constant(50.0)), Greater(Input("moisture"), Constant(0.5))]),
                (category: "scree", when: [Greater(Input("height"), Constant(50.0))]),

                (category: "polar_desert", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.2)), Less(Input("moisture"), Constant(0.3))]),
                (category: "tundra", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.2)), Less(Input("moisture"), Constant(0.5))]),
                (category: "bog_tundra", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.2)), Less(Input("moisture"), Constant(0.7))]),
                (category: "frost_marsh", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.2))]),
                (category: "cold_steppe", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.4)), Less(Input("moisture"), Constant(0.3))]),
                (category: "taiga", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.4)), Less(Input("moisture"), Constant(0.5))]),
                (category: "spruce_forest", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.4)), Less(Input("moisture"), Constant(0.7))]),
                (category: "muskeg", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.4))]),
                (category: "prairie", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.6)), Less(Input("moisture"), Constant(0.3))]),
                (category: "meadow", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.6)), Less(Input("moisture"), Constant(0.5))]),
                (category: "broadleaf_forest", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.6)), Less(Input("moisture"), Constant(0.7))]),
                (category: "fen", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.6))]),
                (category: "shrubland", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.8)), Less(Input("moisture"), Constant(0.3))]),
                (category: "savanna", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.8)), Less(Input("moisture"), Constant(0.5))]),
                (category: "mixed_woodland", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.8)), Less(Input("moisture"), Constant(0.7))]),
                (category: "swamp", when: [Less(Input("height"), Constant(25.0)), Less(Input("temperature"), Constant(0.8))]),
                (category: "desert", when: [Less(Input("height"), Constant(25.0)), Less(Input("moisture"), Constant(0.3))]),
                (category: "dry_scrub", when: [Less(Input("height"), Constant(25.0)), Less(Input("moisture"), Constant(0.5))]),
                (category: "rainforest", when: [Less(Input("height"), Constant(25.0)), Less(Input("moisture"), Constant(0.7))]),
                (category: "mangrove", when: [Less(Input("height"), Constant(25.0))]),

                (category: "rock_plateau", when: [Less(Input("temperature"), Constant(0.2)), Less(Input("moisture"), Constant(0.3))]),
                (category: "lichen_highland", when: [Less(Input("temperature"), Constant(0.2)), Less(Input("moisture"), Constant(0.5))]),
                (category: "alpine_tundra", when: [Less(Input("temperature"), Constant(0.2)), Less(Input("moisture"), Constant(0.7))]),
                (category: "cold_mire", when: [Less(Input("temperature"), Constant(0.2))]),
                (category: "upland_steppe", when: [Less(Input("temperature"), Constant(0.4)), Less(Input("moisture"), Constant(0.3))]),
                (category: "pine_highland", when: [Less(Input("temperature"), Constant(0.4)), Less(Input("moisture"), Constant(0.5))]),
                (category: "fir_highland", when: [Less(Input("temperature"), Constant(0.4)), Less(Input("moisture"), Constant(0.7))]),
                (category: "upland_mire", when: [Less(Input("temperature"), Constant(0.4))]),
                (category: "upland_heath", when: [Less(Input("temperature"), Constant(0.6)), Less(Input("moisture"), Constant(0.3))]),
                (category: "hill_pasture", when: [Less(Input("temperature"), Constant(0.6)), Less(Input("moisture"), Constant(0.5))]),
                (category: "oak_hills", when: [Less(Input("temperature"), Constant(0.6)), Less(Input("moisture"), Constant(0.7))]),
                (category: "upland_bog", when: [Less(Input("temperature"), Constant(0.6))]),
                (category: "mesa", when: [Less(Input("temperature"), Constant(0.8)), Less(Input("moisture"), Constant(0.3))]),
                (category: "chaparral", when: [Less(Input("temperature"), Constant(0.8)), Less(Input("moisture"), Constant(0.5))]),
                (category: "cloud_forest", when: [Less(Input("temperature"), Constant(0.8)), Less(Input("moisture"), Constant(0.7))]),
                (category: "highland_marsh", when: [Less(Input("temperature"), Constant(0.8))]),
                (category: "badlands", when: [Less(Input("moisture"), Constant(0.3))]),
                (category: "thorn_highland", when: [Less(Input("moisture"), Constant(0.5))]),
                (category: "jungle_hills", when: [Less(Input("moisture"), Constant(0.7))]),
            ],
            otherwise: "highland_swamp",
        )),
        // Each biome's own ground, blended over four cells where biomes meet: the oceans deepen,
        // the peaks steepen, wetlands lie nearly flat, mesas and badlands rise in terraces, and
        // deserts in dunes.
        (name: "dunes", kind: Field(Mul(Sin(Add(Mul(X, Constant(0.09)), Mul(Noise(frequency: 0.01, octaves: 2, name: Some("dunes")), Constant(6.0)))), Constant(1.5)))),
        (name: "terrain", kind: Field(Match(
            input: "biome",
            cases: [
                ("deep_ocean", Mul(Input("height"), Constant(1.6))),
                ("ocean", Mul(Input("height"), Constant(1.3))),
                ("ice_peaks", Add(Constant(70.0), Mul(Sub(Input("height"), Constant(70.0)), Constant(1.8)))),
                ("snow_peaks", Add(Constant(70.0), Mul(Sub(Input("height"), Constant(70.0)), Constant(1.6)))),
                ("scree", Add(Input("height"), Mul(Input("ridges"), Constant(4.0)))),
                ("frost_marsh", Add(Constant(2.0), Mul(Sub(Input("height"), Constant(2.0)), Constant(0.3)))),
                ("muskeg", Add(Constant(2.0), Mul(Sub(Input("height"), Constant(2.0)), Constant(0.3)))),
                ("fen", Add(Constant(2.0), Mul(Sub(Input("height"), Constant(2.0)), Constant(0.3)))),
                ("swamp", Add(Constant(1.5), Mul(Sub(Input("height"), Constant(1.5)), Constant(0.2)))),
                ("mangrove", Add(Constant(1.0), Mul(Sub(Input("height"), Constant(1.0)), Constant(0.15)))),
                ("desert", Add(Input("height"), Input("dunes"))),
                ("mesa", Mul(Floor(Mul(Input("height"), Constant(0.2))), Constant(5.0))),
                ("badlands", Add(Mul(Floor(Mul(Input("height"), Constant(0.33))), Constant(3.0)), Mul(Input("ridges"), Constant(2.0)))),
                ("upland_mire", Add(Constant(26.0), Mul(Sub(Input("height"), Constant(26.0)), Constant(0.4)))),
                ("upland_bog", Add(Constant(26.0), Mul(Sub(Input("height"), Constant(26.0)), Constant(0.4)))),
                ("highland_marsh", Add(Constant(26.0), Mul(Sub(Input("height"), Constant(26.0)), Constant(0.4)))),
            ],
            otherwise: Input("height"),
            blend: 4,
        ))),
        // Lakes in the terrain's hollows, and rivers from the high ground to the sea or a lake,
        // in regions of 64 chunks, carved into the terrain.
        (name: "lakes", kind: Lakes(height: "terrain", region: 64, min_columns: 12)),
        (name: "rivers", kind: Rivers(height: "terrain", region: 64, sources: 6, width: (0.8, 3.0), step: 2)),
        (name: "carved", kind: Apply(height: "terrain", curves: "rivers", max_radius: 3, blend: 2,
            profile: Carve(0.8))),
        // How uneven the ground is, and where each biome ends, for what is placed on it.
        (name: "roughness", kind: Delta(input: "terrain", radius: 2)),
        (name: "biome_area", kind: Area(input: "biome", distance: 4)),
        // The location table: 33 kinds in every region of 64 chunks, each in the biomes it belongs
        // to, on ground gentle enough and above the sea, with a quota and a distance from its own
        // kind. The larger and rarer first: towns and castles before farmsteads and camps.
        (name: "places", persist: Frozen, kind: Locations(height: "carved", region: 64, kinds: [
            (name: "market_town", priority: 20, quota: 1, size: 6, tries: 200, when: [
                Greater(Is("biome", ["meadow", "prairie", "broadleaf_forest", "hill_pasture", "mixed_woodland", "savanna"]), Constant(0.5)),
                Less(Input("roughness"), Constant(2.0)), Greater(Input("carved"), Constant(2.0))]),
            (name: "harbour_town", priority: 19, quota: 1, size: 4, tries: 200, when: [
                Greater(Is("biome", ["beach", "shingle"]), Constant(0.5)), Less(Input("roughness"), Constant(2.5))]),
            (name: "castle", priority: 18, quota: 1, size: 4, tries: 120, when: [
                Greater(Is("biome", ["hill_pasture", "oak_hills", "upland_heath", "chaparral"]), Constant(0.5)),
                Less(Input("roughness"), Constant(3.0))]),
            (name: "monastery", priority: 17, quota: 1, size: 4, tries: 120, when: [
                Greater(Is("biome", ["alpine_meadow", "cloud_forest", "fir_highland"]), Constant(0.5)),
                Less(Input("roughness"), Constant(3.0))]),
            (name: "frost_fort", priority: 16, quota: 1, size: 4, tries: 120, when: [
                Greater(Is("biome", ["tundra", "polar_desert", "lichen_highland", "rock_plateau"]), Constant(0.5)),
                Less(Input("roughness"), Constant(3.0))]),
            (name: "jungle_ziggurat", priority: 15, quota: 1, size: 4, tries: 120, when: [
                Greater(Is("biome", ["rainforest", "jungle_hills"]), Constant(0.5))]),
            (name: "desert_ruins", priority: 14, quota: 1, size: 4, tries: 120, when: [
                Greater(Is("biome", ["desert", "badlands", "dry_scrub"]), Constant(0.5))]),
            (name: "cliff_dwelling", priority: 13, quota: 2, apart: 96.0, tries: 120, when: [
                Greater(Is("biome", ["mesa", "badlands"]), Constant(0.5))]),
            (name: "fishing_village", priority: 12, quota: 3, apart: 128.0, tries: 120, when: [
                Greater(Is("biome", ["beach", "shingle", "mangrove"]), Constant(0.5))]),
            (name: "stilt_village", priority: 11, quota: 2, apart: 128.0, tries: 120, when: [
                Greater(Is("biome", ["fen", "swamp", "mangrove", "highland_marsh"]), Constant(0.5))]),
            (name: "hamlet", priority: 10, quota: 4, apart: 96.0, tries: 120, when: [
                Greater(Is("biome", ["meadow", "prairie", "broadleaf_forest", "taiga", "savanna", "mixed_woodland", "hill_pasture"]), Constant(0.5)),
                Less(Input("roughness"), Constant(2.5)), Greater(Input("carved"), Constant(1.5))]),
            (name: "nomad_camp", priority: 9, quota: 2, apart: 128.0, tries: 80, when: [
                Greater(Is("biome", ["cold_steppe", "upland_steppe", "prairie", "savanna"]), Constant(0.5))]),
            (name: "caravanserai", priority: 9, quota: 1, tries: 80, when: [
                Greater(Is("biome", ["desert", "dry_scrub", "savanna", "shrubland"]), Constant(0.5))]),
            (name: "oasis", priority: 9, quota: 2, apart: 160.0, tries: 80, when: [
                Greater(Is("biome", ["desert"]), Constant(0.5)), Greater(Is("biome_area", ["median"]), Constant(0.5))]),
            (name: "watchtower", priority: 8, quota: 3, apart: 128.0, tries: 80, when: [
                Greater(Is("biome", ["hill_pasture", "upland_heath", "pine_highland", "upland_steppe", "chaparral"]), Constant(0.5))]),
            (name: "lighthouse", priority: 8, quota: 2, apart: 200.0, tries: 80, when: [
                Greater(Is("biome", ["shingle", "beach"]), Constant(0.5)), Greater(Is("biome_area", ["edge"]), Constant(0.5))]),
            (name: "mine_entrance", priority: 8, quota: 3, apart: 96.0, tries: 80, when: [
                Greater(Is("biome", ["scree", "rock_plateau", "mesa", "pine_highland"]), Constant(0.5))]),
            (name: "quarry", priority: 7, quota: 2, apart: 128.0, tries: 80, when: [
                Greater(Is("biome", ["rock_plateau", "mesa", "scree", "upland_heath"]), Constant(0.5))]),
            (name: "farmstead", priority: 7, quota: 6, apart: 64.0, tries: 120, when: [
                Greater(Is("biome", ["meadow", "prairie", "hill_pasture", "savanna", "mixed_woodland"]), Constant(0.5)),
                Less(Input("roughness"), Constant(2.0))]),
            (name: "mill", priority: 7, quota: 2, apart: 128.0, tries: 80, when: [
                Greater(Is("biome", ["meadow", "prairie", "hill_pasture", "fen"]), Constant(0.5)),
                Less(Input("roughness"), Constant(2.0))]),
            (name: "hunters_lodge", priority: 6, quota: 3, apart: 96.0, tries: 80, when: [
                Greater(Is("biome", ["taiga", "spruce_forest", "pine_highland", "fir_highland"]), Constant(0.5))]),
            (name: "woodcutter_camp", priority: 6, quota: 3, apart: 96.0, tries: 80, when: [
                Greater(Is("biome", ["broadleaf_forest", "spruce_forest", "mixed_woodland", "oak_hills"]), Constant(0.5))]),
            (name: "druid_circle", priority: 5, quota: 1, tries: 80, when: [
                Greater(Is("biome", ["oak_hills", "broadleaf_forest"]), Constant(0.5)), Greater(Is("biome_area", ["median"]), Constant(0.5))]),
            (name: "standing_stones", priority: 5, quota: 2, apart: 160.0, tries: 80, when: [
                Greater(Is("biome", ["upland_heath", "tundra", "lichen_highland", "hill_pasture"]), Constant(0.5))]),
            (name: "barrow", priority: 5, quota: 3, apart: 96.0, tries: 80, when: [
                Greater(Is("biome", ["tundra", "bog_tundra", "upland_heath", "cold_steppe"]), Constant(0.5))]),
            (name: "ice_shrine", priority: 5, quota: 1, tries: 80, when: [
                Greater(Is("biome", ["glacier", "ice_peaks"]), Constant(0.5))]),
            (name: "sunken_temple", priority: 5, quota: 1, tries: 80, when: [
                Greater(Is("biome", ["swamp", "mangrove", "fen", "muskeg"]), Constant(0.5))]),
            (name: "witch_hut", priority: 4, quota: 2, apart: 160.0, tries: 80, when: [
                Greater(Is("biome", ["bog_tundra", "muskeg", "upland_bog", "cold_mire", "upland_mire", "frost_marsh"]), Constant(0.5))]),
            (name: "hot_spring", priority: 4, quota: 1, tries: 80, when: [
                Greater(Is("biome", ["cloud_forest", "alpine_meadow", "scree"]), Constant(0.5))]),
            (name: "shipwreck", priority: 4, quota: 2, apart: 200.0, tries: 80, when: [
                Greater(Is("biome", ["beach", "shingle", "shallows"]), Constant(0.5))]),
            (name: "bandit_camp", priority: 3, quota: 2, apart: 160.0, tries: 80, when: [
                Greater(Is("biome", ["chaparral", "shrubland", "dry_scrub", "thorn_highland", "savanna"]), Constant(0.5))]),
            (name: "ruined_keep", priority: 3, quota: 2, apart: 160.0, tries: 80, when: [
                Greater(Is("biome", ["hill_pasture", "upland_heath", "oak_hills", "upland_bog"]), Constant(0.5))]),
            (name: "crypt", priority: 2, quota: 3, apart: 128.0, tries: 120, when: [
                Greater(Input("carved"), Constant(2.0)), Less(Input("roughness"), Constant(4.0))]),
        ])),
        // The ground levelled over every place and blended back over four cells around it.
        (name: "flattened", kind: Flatten(height: "carved", sites: "places", blend: 4)),
        // The history's settlements, each a site of two to six chunks a side where its row puts
        // it, levelled into the ground over six cells around it.
        (name: "settlements", kind: TableSites(table: "settlements", height: "flattened", at: ("x", "y"), size: "size", max_size: 6)),
        (name: "settled", kind: Flatten(height: "flattened", sites: "settlements", blend: 6)),
        // Roads joining the places of each region of 64 chunks, round the ridges and never through
        // the sea or a lake, levelled across their width into the ground a player walks.
        (name: "roads", kind: Network(sites: "places", height: "settled", region: 64, width: 1.5, climb: 4.0, dry: Some(0.5))),
        (name: "ground", kind: Apply(height: "settled", curves: "roads", max_radius: 2, blend: 2, profile: Level)),
        // Every settlement's town, of its culture's module set: streets on the levelled ground,
        // buildings with one roof each, air above.
        (name: "towns", kind: Solve(sites: "settlements", rules: "woodlanders",
            by: Some(("culture", [
                ("coastfolk", "coastfolk"), ("steppe_riders", "steppe_riders"),
                ("sand_dwellers", "sand_dwellers"), ("highlanders", "highlanders"),
                ("marsh_folk", "marsh_folk"), ("jungle_folk", "jungle_folk"), ("frostfolk", "frostfolk"),
            ])),
            bottom: Some(Tagged("street_level")), top: Some(Named("air")))),
        // How much a column is cliff: none on ground that climbs under 3 cells within two, all of
        // it from 8.
        (name: "cliffs", kind: Field(Smoothstep(3.0, 8.0, Input("roughness")))),
        // The rock under the ground, as a density volume: solid from three cells under the
        // ground's surface down, so the ground a player walks stays the height field's; cheese
        // caves where the cave noise is high, from eight to forty cells down; and on cliffs, blobs
        // of rock that overhang the ground. Far from the surface a voxel is air above it and rock
        // below, so the noises are read only near it. It reaches 64 cells up: the peaks above
        // have no overhangs, and their ground is the height field's.
        (name: "rock", kind: Volume(
            density: Select(
                when: Greater(Z, Add(Input("ground"), Constant(10.0))),
                then: Sub(Input("ground"), Z),
                otherwise: Select(
                    when: Less(Z, Sub(Input("ground"), Constant(40.0))),
                    then: Sub(Sub(Input("ground"), Constant(3.0)), Z),
                    otherwise: Select(
                        when: Less(Z, Sub(Input("ground"), Constant(8.0))),
                        then: Sub(Constant(3.0), Mul(FastNoise("caves"), Constant(10.0))),
                        otherwise: Select(
                            when: Greater(Input("cliffs"), Constant(0.0)),
                            then: Max(
                                Sub(Sub(Input("ground"), Constant(3.0)), Z),
                                Mul(Input("cliffs"), Sub(Mul(FastNoise("overhangs"), Constant(12.0)), Add(Constant(3.0), Abs(Sub(Z, Input("ground")))))),
                            ),
                            otherwise: Sub(Sub(Input("ground"), Constant(3.0)), Z),
                        ),
                    ),
                ),
            ),
            bottom: -40,
            top: 64,
            materials: Some((rules: [
                (category: "granite", when: [Greater(Is("biome", ["ice_peaks", "snow_peaks", "scree", "alpine_meadow"]), Constant(0.5))]),
                (category: "sandstone", when: [Greater(Is("biome", ["mesa", "badlands", "desert", "dry_scrub"]), Constant(0.5))]),
                (category: "limestone", when: [Greater(Z, Sub(Input("ground"), Constant(30.0)))]),
            ], otherwise: "basalt")),
        )),
        // Ore in the rock: coal near the surface, iron and copper deeper, gold deepest and rarest.
        (name: "coal", kind: Embed(kind: "coal", volume: "rock", spacing: 6, count: (1, 3), between: (-30.0, 60.0),
            when: [Less(Z, Sub(Input("ground"), Constant(4.0)))])),
        (name: "iron", kind: Embed(kind: "iron", volume: "rock", spacing: 8, count: (1, 2), between: (-40.0, 40.0),
            when: [Less(Z, Sub(Input("ground"), Constant(10.0)))])),
        (name: "copper", kind: Embed(kind: "copper", volume: "rock", spacing: 10, between: (-40.0, 30.0),
            when: [Less(Z, Sub(Input("ground"), Constant(12.0)))])),
        (name: "gold", kind: Embed(kind: "gold", volume: "rock", spacing: 16, between: (-40.0, 0.0),
            when: [Less(Z, Sub(Input("ground"), Constant(20.0)))])),
    ],
)
