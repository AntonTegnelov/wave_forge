// The pack of the tables check (verify_tables.gd): a given table of villages, houses generated
// under each village sharing its population, a field that reads the focused village, a site for
// every village, and roads levelled into the hills.
(
    version: 1,
    tables: [
        (name: "villages", kind: Given(columns: [
            ("x", Number),
            ("y", Number),
            ("size", Number),
            ("population", Number),
            ("culture", Names(["river", "hill"])),
        ])),
        (name: "roads", kind: Given(columns: [
            ("x0", Number), ("y0", Number), ("x1", Number), ("y1", Number), ("width", Number),
        ])),
        (name: "houses", kind: Generated(parent: Some("villages"),
            count: Floor(Mul(Parent("population"), Constant(0.01))),
            columns: [("people", Share("population"))])),
    ],
    stages: [
        (name: "hills", kind: Field(Mul(Noise(frequency: 0.05, octaves: 3), Constant(10.0)))),
        (name: "wealth", kind: Field(Add(Input("hills"), Row("villages", "population")))),
        (name: "roads", kind: TableCurves(table: "roads", from: ("x0", "y0"), to: ("x1", "y1"), radius: "width")),
        (name: "paved", kind: Apply(height: "hills", curves: "roads", max_radius: 2, profile: Level)),
        (name: "places", kind: TableSites(table: "villages", height: "hills", at: ("x", "y"), size: "size", max_size: 2)),
    ],
)
