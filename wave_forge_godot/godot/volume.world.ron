// The pack of the volume check (verify_volume.gd): ground solid below 6.3 cells with a cave
// running under all of it, from 1.8 to 4.2 cells up, whose ceiling a height field could not hold;
// grass on top and rock below, pools of water and lava in the cave, and ore embedded in the rock.
(
    version: 1,
    stages: [
        (name: "height", kind: Field(Constant(6.3))),
        (name: "cave", kind: Volume(
            density: Min(Sub(Input("height"), Z), Max(Sub(Z, Constant(4.2)), Sub(Constant(1.8), Z))),
            bottom: -2,
            top: 10,
            // Grass on the ground's top, rock in the cave.
            materials: Some((rules: [(category: "grass", when: [Greater(Z, Constant(5.0))])], otherwise: "rock")),
        )),
        // Pools in the cave, each at its own level from 2.4 to 3.4 cells, lava below 2.9.
        (name: "water", kind: Aquifer(volume: "cave", cell: (6, 4), level: (2.4, 3.4),
            materials: Some((rules: [(category: "lava", when: [Less(Z, Constant(2.9))])], otherwise: "water")))),
        // Ore in the rock above and below the cave, never in it.
        (name: "ore", kind: Embed(kind: "ore", volume: "cave", spacing: 3, count: (1, 2), between: (-2.0, 6.0))),
    ],
)
